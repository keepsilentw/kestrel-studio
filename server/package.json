{
  "name": "kestrel-server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend: agent loop over Bailian Token Plan, SSR + SSE",
  "//": "The nest and drizzle-kit commands run from the REPO ROOT (`cd ..`) because `.env`, `DATABASE_FILE` and `STORAGE_DIR` are resolved from the working directory: launched from inside this directory the process would open a fresh empty database. PATH already points at server/node_modules/.bin when the script starts, so `cd ..` does not lose the binaries. The CLI is pointed at this package's configs with -c / -p.",
  "scripts": {
    "build": "cd .. && nest build -c server/nest-cli.json -p server/tsconfig.json",
    "start": "cd .. && nest start -c server/nest-cli.json -p server/tsconfig.json",
    "dev": "cd .. && nest start --watch -c server/nest-cli.json -p server/tsconfig.json",
    "start:prod": "cd .. && node server/dist/main.js",
    "db:push": "cd .. && drizzle-kit push --config server/drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "better-sqlite3-session-store": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "express-session": "^1.19.0",
    "hbs": "^4.3.1",
    "marked": "^18.0.13",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/hbs": "^4.0.5",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "node-gyp": "^13.0.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
