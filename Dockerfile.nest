# The NestJS backend, assembled on the target host with ZERO network access.
#
# Kept in its own file so the Rust pipeline's `Dockerfile` (scratch, no base image
# at all) stays untouched: `make deploy` keeps doing exactly what it did before.
# Both stacks are long-lived now (docs/roadmap.md §4.5), so each has its own image
# rather than one being a rollback copy of the other.
#
# Why this one base image and no other: the host's outbound bandwidth is ~65 KB/s
# and Docker Hub is unreachable there, so every layer has to come from the local
# cache — `docker images` on lavo-test already holds
# `dockerproxy.net/library/node:24-bookworm-slim` (230 MB). CentOS 7 (glibc 2.17)
# cannot run Node at all, which is why this stack stays containerised while Rust
# does not need to be. `node_modules` is a build input shipped from the dev machine
# where the network is fast (`scripts/deploy-nest.sh` whitelists it); installing it
# on the host would take ~25 minutes at 65 KB/s.
#
# There is no native-build stage, and that is a change from the pre-split pipeline,
# which compiled better-sqlite3 in a golang:1.24 stage (docs/deployment.md §1.1's
# three caveats). That step is dead: better-sqlite3 v13 bundles prebuilds for eight
# platforms inside the package (`node_modules/.pnpm/better-sqlite3@13.0.3/…/
# prebuilds/linux-x64.node` and friends) and its loader picks the matching one at
# require time. Measured on the host 2026-11-07: `node-gyp rebuild` produced nothing
# but an empty `build/Release/obj.target`, and the app still opened SQLite and
# served /login. Dropping the stage also drops the 853 MB builder base — the
# Nest-era images that ended in it left six 1.3 GB `<none>` layers on that host.
FROM dockerproxy.net/library/node:24-bookworm-slim

WORKDIR /app

# Four explicit paths, never `COPY . .`: `data/` and `storage/` are host volumes
# that must not enter the image, `.env` is a secret, and `src/` has no business in a
# runtime layer. The package's own `node_modules` is a symlink farm whose links are
# relative (`../../../node_modules/.pnpm/…`), so it has to keep its position under
# the root store copied above it — COPY preserves them as symlinks.
COPY node_modules /app/node_modules
COPY nest/server/node_modules /app/nest/server/node_modules
COPY nest/server/dist /app/nest/server/dist
COPY public /app/public

ENV NODE_ENV=production
# The second backend listens on its own port so both can be up at the same time;
# compose overrides this the same way it overrides `PORT` for the Rust service
# (docs/deployment.md §2: a mutable port must not live in the never-rewritten `.env`).
ENV PORT=8849
EXPOSE 8849

# The compiled entry point sits three levels under the image root on purpose:
# `main.ts` resolves `public/` with `join(__dirname, '..', '..', '..', 'public')`,
# and `.env`, `DATABASE_FILE` and `STORAGE_DIR` are resolved from the working
# directory, which must stay the repo root (CLAUDE.md, 拆分的三条口径 (3)).
CMD ["node", "nest/server/dist/main.js"]
