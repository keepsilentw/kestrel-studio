<article class="turn turn-{{this.role}}" data-message-id="{{this.id}}">
  {{#if this.modeLabel}}
    <span class="turn-mode">{{this.modeLabel}}</span>
  {{/if}}

  {{#if this.reasoning}}
    <details class="reasoning">
      <summary>思考过程</summary>
      <pre class="reasoning-body">{{this.reasoning}}</pre>
    </details>
  {{/if}}

  {{! Tool calls are persisted on the message; replay them here so a reloaded
      page shows the same "called X → got Y" trail the live stream built. }}
  {{#if this.toolCalls}}
    <ul class="tool-calls">
      {{#each this.toolCalls}}
        <li class="tool-call">{{this.name}} — {{this.summary}}</li>
      {{/each}}
    </ul>
  {{/if}}

  {{#if this.contentHtml}}
    <div class="content">{{{this.contentHtml}}}</div>
  {{else}}
    {{! The user's words are plain text, printed escaped — the same thing
        textContent does on the live path in nest/client/scripts/main.ts. Keeping the
        bubble free of block children is also what makes its height hug the text. }}
    {{#if this.content}}
      <div class="content">{{this.content}}</div>
    {{/if}}
  {{/if}}

  {{#each this.assets}}
    <figure class="asset">
      {{#if (eq this.kind "video")}}
        <video src="{{this.url}}" controls preload="metadata" class="asset-video"></video>
      {{else}}
        {{! Both dimensions or neither: a lone width lets the browser keep its own
            ratio, which distorts the reserved box instead of fixing the reflow. Same
            rule as rust/server/src/view/templates.rs. Nested rather than (and …)
            because this app registers one helper only, `eq` (src/main.ts:40) — and a
            missing helper is a render-time throw, not a compile error. }}
        <img src="{{this.url}}"{{#if this.width}}{{#if this.height}} width="{{this.width}}" height="{{this.height}}"{{/if}}{{/if}} alt="生成的图片" loading="lazy" class="asset-image">
      {{/if}}
      <figcaption class="asset-actions">
        <a href="{{this.url}}" download class="asset-download">下载</a>
      </figcaption>
    </figure>
  {{/each}}
</article>
