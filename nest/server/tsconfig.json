{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  // Anchored at this directory: the sibling app (`../client`) is a separate
  // program with its own tsconfig, and `__tests__` belongs to tsconfig.test.json
  // because a test-only import (vitest) leaking into `nest build` would break
  // `make build` / `make start` / `make deploy`, not just the tests.
  "exclude": ["node_modules", "dist", "__tests__"]
}
